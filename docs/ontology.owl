    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/eu-meddevice#hasActionDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/eu-meddevice#hasActionDate">
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#FSCA"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Stores the action date.</rdfs:comment>
        <rdfs:label xml:lang="en">hasActionDate</rdfs:label>
        <skos:definition xml:lang="en">Stores the action date.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasAuthorizationNumber -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/eu-meddevice#hasAuthorizationNumber">
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Stores the manufacturer authorisation number.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAuthorizationNumber</rdfs:label>
        <skos:definition xml:lang="en">Stores the manufacturer authorisation number.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasClosureDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/eu-meddevice#hasClosureDate">
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#FSCA"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Stores the closure date when available.</rdfs:comment>
        <rdfs:label xml:lang="en">hasClosureDate</rdfs:label>
        <skos:definition xml:lang="en">Stores the closure date when available.</skos:definition>
    </owl:DatatypeProperty>
    


