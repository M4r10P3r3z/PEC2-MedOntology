    <!-- http://www.example.org/eu-meddevice#Device -->


    <owl:Class rdf:about="http://www.example.org/eu-meddevice#Device">
        <rdfs:subClassOf rdf:resource="http://www.example.org/eu-meddevice#MedicalCatalogueEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/eu-meddevice#governedByFramework"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/eu-meddevice#RegulatoryFramework"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/eu-meddevice#hasManufacturer"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/eu-meddevice#Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/eu-meddevice#hasRiskClass"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/eu-meddevice#RiskClass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Medical device or in vitro diagnostic product registered in the catalogue.</rdfs:comment>
        <rdfs:label xml:lang="en">Device</rdfs:label>
        <skos:definition xml:lang="en">Medical device or in vitro diagnostic product registered in the catalogue.</skos:definition>
    </owl:Class>
    


