    <!-- http://www.example.org/eu-meddevice#Incident -->


    <owl:Class rdf:about="http://www.example.org/eu-meddevice#Incident">
        <rdfs:subClassOf rdf:resource="http://www.example.org/eu-meddevice#MedicalCatalogueEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/eu-meddevice#involvesDevice"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/eu-meddevice#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/eu-meddevice#isAssociatedWithRisk"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/eu-meddevice#Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Reported incident linked to a device and a risk.</rdfs:comment>
        <rdfs:label xml:lang="en">Incident</rdfs:label>
        <skos:definition xml:lang="en">Reported incident linked to a device and a risk.</skos:definition>
    </owl:Class>
    


