        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Stores the device commercial name.</rdfs:comment>
        <rdfs:label xml:lang="en">hasDeviceName</rdfs:label>
