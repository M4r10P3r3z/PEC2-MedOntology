<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/eu-meddevice#"
     xml:base="http://www.example.org/eu-meddevice"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:eu-meddevice="http://www.example.org/eu-meddevice#">
    <owl:Ontology rdf:about="http://www.example.org/eu-meddevice#">
        <terms:creator>Mario Pérez Martínez</terms:creator>
        <terms:description xml:lang="en">OWL ontology for high-risk medical devices and in vitro diagnostics, including manufacturers, risks, incidents and field safety corrective actions under MDR and IVDR.</terms:description>
        <terms:title xml:lang="en">EU High-Risk Medical Devices and IVD Ontology</terms:title>
        <rdfs:comment xml:lang="en">Ontology created for PEC 2 about high-risk medical devices and in vitro diagnostics.</rdfs:comment>
        <rdfs:label xml:lang="en">EU High-Risk Medical Devices and IVD Ontology</rdfs:label>
        <owl:versionInfo>1.0</owl:versionInfo>
        <skos:definition xml:lang="en">OWL ontology for high-risk medical devices and in vitro diagnostics, including manufacturers, risks, incidents and field safety corrective actions.</skos:definition>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2003/11/swrl#argument1 -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#argument1"/>
    


    <!-- http://www.w3.org/2003/11/swrl#argument2 -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#argument2"/>
    


    <!-- http://www.w3.org/2003/11/swrl#body -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#body"/>
    


    <!-- http://www.w3.org/2003/11/swrl#classPredicate -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#classPredicate"/>
    


    <!-- http://www.w3.org/2003/11/swrl#head -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#head"/>
    


    <!-- http://www.w3.org/2003/11/swrl#propertyPredicate -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#propertyPredicate"/>
    


    <!-- http://www.w3.org/2003/11/swrl#varName -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#varName"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/eu-meddevice#addressesIncident -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#addressesIncident">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#FSCA"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#Incident"/>
        <rdfs:comment xml:lang="en">Links an FSCA to the incident it addresses.</rdfs:comment>
        <rdfs:label xml:lang="en">addressesIncident</rdfs:label>
        <skos:definition xml:lang="en">Links an FSCA to the incident it addresses.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#affectsDevice -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#affectsDevice">
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#FSCA"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#Device"/>
        <rdfs:comment xml:lang="en">Inferred property linking an FSCA to the device affected by the action.</rdfs:comment>
        <rdfs:label xml:lang="en">affectsDevice</rdfs:label>
        <skos:definition xml:lang="en">Inferred property linking an FSCA to the device affected by the action.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#governedByFramework -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#governedByFramework">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#RegulatoryFramework"/>
        <rdfs:comment xml:lang="en">Links a device to the regulatory framework under which it is registered.</rdfs:comment>
        <rdfs:label xml:lang="en">governedByFramework</rdfs:label>
        <skos:definition xml:lang="en">Links a device to the regulatory framework under which it is registered.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasFSCAStatus -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#hasFSCAStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#FSCA"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#FSCAStatus"/>
        <rdfs:comment xml:lang="en">Links an FSCA to its status.</rdfs:comment>
        <rdfs:label xml:lang="en">hasFSCAStatus</rdfs:label>
        <skos:definition xml:lang="en">Links an FSCA to its status.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasManufacturer -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#hasManufacturer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#Manufacturer"/>
        <rdfs:comment xml:lang="en">Links a device to its manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">hasManufacturer</rdfs:label>
        <skos:definition xml:lang="en">Links a device to its manufacturer.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasPatientSex -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#hasPatientSex">
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#SexCategory"/>
        <rdfs:comment xml:lang="en">Relates an incident to the patient sex category when available.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPatientSex</rdfs:label>
        <skos:definition xml:lang="en">Relates an incident to the patient sex category when available.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasProbability -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#hasProbability">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Risk"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#ProbabilityLevel"/>
        <rdfs:comment xml:lang="en">Links a risk to its probability level.</rdfs:comment>
        <rdfs:label xml:lang="en">hasProbability</rdfs:label>
        <skos:definition xml:lang="en">Links a risk to its probability level.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasRelatedRisk -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#hasRelatedRisk">
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#Risk"/>
        <rdfs:comment xml:lang="en">Inferred property linking a device to a risk mentioned in an incident.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRelatedRisk</rdfs:label>
        <skos:definition xml:lang="en">Inferred property linking a device to a risk mentioned in an incident.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasRiskCategory -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#hasRiskCategory">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Risk"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#RiskCategory"/>
        <rdfs:comment xml:lang="en">Links a risk to its risk category.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRiskCategory</rdfs:label>
        <skos:definition xml:lang="en">Links a risk to its risk category.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasRiskClass -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#hasRiskClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#RiskClass"/>
        <rdfs:comment xml:lang="en">Links a device to its risk class.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRiskClass</rdfs:label>
        <skos:definition xml:lang="en">Links a device to its risk class.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#hasSeverity -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#hasSeverity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Risk"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#SeverityLevel"/>
        <rdfs:comment xml:lang="en">Links a risk to its severity level.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSeverity</rdfs:label>
        <skos:definition xml:lang="en">Links a risk to its severity level.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#involvesDevice -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#involvesDevice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#Device"/>
        <rdfs:comment xml:lang="en">Links an incident to the involved device.</rdfs:comment>
        <rdfs:label xml:lang="en">involvesDevice</rdfs:label>
        <skos:definition xml:lang="en">Links an incident to the involved device.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#isAssociatedWithRisk -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#isAssociatedWithRisk">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#Risk"/>
        <rdfs:comment xml:lang="en">Links an incident to the related risk.</rdfs:comment>
        <rdfs:label xml:lang="en">isAssociatedWithRisk</rdfs:label>
        <skos:definition xml:lang="en">Links an incident to the related risk.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#isSubclassifiedUnder -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#isSubclassifiedUnder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#MedicalCatalogueEntity"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#MedicalCatalogueEntity"/>
        <rdfs:comment xml:lang="en">Transitive property reused from Exercise 1 to represent transitive classification links between classification resources.</rdfs:comment>
        <rdfs:label xml:lang="en">isSubclassifiedUnder</rdfs:label>
        <skos:definition xml:lang="en">Transitive property reused from Exercise 1 to represent transitive classification links between classification resources.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#locatedInCountry -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#locatedInCountry">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#Country"/>
        <rdfs:comment xml:lang="en">Links a manufacturer to its country.</rdfs:comment>
        <rdfs:label xml:lang="en">locatedInCountry</rdfs:label>
        <skos:definition xml:lang="en">Links a manufacturer to its country.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#reportedBy -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#reportedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#ReportableEntity"/>
        <rdfs:comment xml:lang="en">Links an incident to the reporting entity.</rdfs:comment>
        <rdfs:label xml:lang="en">reportedBy</rdfs:label>
        <skos:definition xml:lang="en">Links an incident to the reporting entity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#reportedInCountry -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#reportedInCountry">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#Country"/>
        <rdfs:comment xml:lang="en">Links an incident to the country where it was reported.</rdfs:comment>
        <rdfs:label xml:lang="en">reportedInCountry</rdfs:label>
        <skos:definition xml:lang="en">Links an incident to the country where it was reported.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/eu-meddevice#supervisedBy -->


    <owl:ObjectProperty rdf:about="http://www.example.org/eu-meddevice#supervisedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/eu-meddevice#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.example.org/eu-meddevice#CompetentAuthority"/>
        <rdfs:comment xml:lang="en">Links a manufacturer to its supervising competent authority.</rdfs:comment>
        <rdfs:label xml:lang="en">supervisedBy</rdfs:label>
        <skos:definition xml:lang="en">Links a manufacturer to its supervising competent authority.</skos:definition>
    </owl:ObjectProperty>
    


