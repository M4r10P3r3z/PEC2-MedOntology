:hasEventDate rdf:type owl:DatatypeProperty ;
              rdfs:domain :Incident ;
              rdfs:range xsd:date ;
              rdfs:comment "Stores the event date."@en ;
              rdfs:label "hasEventDate"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Stores the event date."@en .


###  http://www.example.org/eu-meddevice#hasFSCAId
:hasFSCAId rdf:type owl:DatatypeProperty ;
           rdfs:domain :FSCA ;
           rdfs:range xsd:string ;
           rdfs:comment "Stores the FSCA identifier."@en ;
           rdfs:label "hasFSCAId"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "Stores the FSCA identifier."@en .


###  http://www.example.org/eu-meddevice#hasFSCAReference
:hasFSCAReference rdf:type owl:DatatypeProperty ;
                  rdfs:domain :FSCA ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Stores the EUDAMED FSCA reference."@en ;
                  rdfs:label "hasFSCAReference"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Stores the EUDAMED FSCA reference."@en .


###  http://www.example.org/eu-meddevice#hasIMDRFCode
:hasIMDRFCode rdf:type owl:DatatypeProperty ;
              rdfs:domain :Risk ;
              rdfs:range xsd:string ;
              rdfs:comment "Stores the IMDRF code."@en ;
              rdfs:label "hasIMDRFCode"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Stores the IMDRF code."@en .


###  http://www.example.org/eu-meddevice#hasIncidentId
:hasIncidentId rdf:type owl:DatatypeProperty ;
