#################################################################
#    Classes
#################################################################

###  http://www.example.org/eu-meddevice#ActiveDevice
:ActiveDevice rdf:type owl:Class ;
              rdfs:subClassOf :Device ;
              rdfs:comment "Device subclass for active devices."@en ;
              rdfs:label "ActiveDevice"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Device subclass for active devices."@en .


###  http://www.example.org/eu-meddevice#ActiveImplant
