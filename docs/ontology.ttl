:hasIntendedPurpose rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Device ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Stores the intended purpose of a device."@en ;
                    rdfs:label "hasIntendedPurpose"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Stores the intended purpose of a device."@en .


###  http://www.example.org/eu-meddevice#hasManufacturerId
:hasManufacturerId rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Manufacturer ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Stores the manufacturer identifier."@en ;
                   rdfs:label "hasManufacturerId"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Stores the manufacturer identifier."@en .


###  http://www.example.org/eu-meddevice#hasName
:hasName rdf:type owl:DatatypeProperty ;
         rdfs:domain :Manufacturer ;
         rdfs:range xsd:string ;
         rdfs:comment "Stores a preferred name."@en ;
         rdfs:label "hasName"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "Stores a preferred name."@en .


