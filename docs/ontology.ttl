:hasOutcome rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:string ;
            rdfs:comment "Stores the incident outcome."@en ;
            rdfs:label "hasOutcome"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Stores the incident outcome."@en .


