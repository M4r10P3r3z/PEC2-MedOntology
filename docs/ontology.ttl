###  http://www.example.org/eu-meddevice#Device
:Device rdf:type owl:Class ;
        rdfs:subClassOf :MedicalCatalogueEntity ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :governedByFramework ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :RegulatoryFramework
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasManufacturer ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Manufacturer
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasRiskClass ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :RiskClass
                        ] ;
        rdfs:comment "Medical device or in vitro diagnostic product registered in the catalogue."@en ;
        rdfs:label "Device"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Medical device or in vitro diagnostic product registered in the catalogue."@en .


