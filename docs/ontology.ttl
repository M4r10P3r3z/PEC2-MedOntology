                :hasDescription "Device of type ImplantableActiveDevice registered under MDR with risk class ClassIII." ;
                :hasDeviceId "DEV-001" ;
                :hasDeviceName "HeartMate 3 LVAD" ;
                :hasIntendedPurpose "Ventricular assist device for end-stage heart failure" ;
                :hasUDIDI "(01)00380740009095" ;
                :isActive "true"^^xsd:boolean ;
                :isIVD "false"^^xsd:boolean ;
                :isImplantable "true"^^xsd:boolean ;
                :isReusable "false"^^xsd:boolean ;
                rdfs:comment "Device DEV-001 named HeartMate 3 LVAD imported from the source CSV."@en ;
                rdfs:label "HeartMate 3 LVAD"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Device of type ImplantableActiveDevice registered under MDR with risk class ClassIII."@en .


###  http://www.example.org/eu-meddevice#FSCA_FSCA-001
:FSCA_FSCA-001 rdf:type owl:NamedIndividual ,
                        :FSCA ,
                        :SafetyAlert ;
               :addressesIncident :Incident_INC-001 ;
               :hasFSCAStatus :Open ;
               :hasActionDate "2024-02-01"^^xsd:date ;
               :hasCountriesAffected "EU-wide" ;
               :hasDescription "Safety alert issued to all implanting centres regarding anticoagulation protocol update for HeartMate 3 to reduce device thrombosis risk. INR target range revised to 2.0–3.0." ;
               :hasDevicesAffected "850" ;
               :hasFSCAId "FSCA-001" ;
               :hasFSCAReference "EU-FSCA-2024-000001" ;
               :hasScope "All HeartMate 3 LVAD units implanted since 2020" ;
               rdfs:comment "FSCA FSCA-001 imported from the source CSV."@en ;
               rdfs:label "FSCA-001"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Safety alert issued to all implanting centres regarding anticoagulation protocol update for HeartMate 3 to reduce device thrombosis risk. INR target range revised to 2.0–3.0."@en .


