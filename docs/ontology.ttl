@prefix : <http://www.example.org/eu-meddevice#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.example.org/eu-meddevice#> .

<http://www.example.org/eu-meddevice#> rdf:type owl:Ontology ;
                                        <http://purl.org/dc/terms/creator> "Mario Pérez Martínez" ;
                                        <http://purl.org/dc/terms/description> "OWL ontology for high-risk medical devices and in vitro diagnostics, including manufacturers, risks, incidents and field safety corrective actions under MDR and IVDR."@en ;
                                        <http://purl.org/dc/terms/title> "EU High-Risk Medical Devices and IVD Ontology"@en ;
                                        rdfs:comment "Ontology created for PEC 2 about high-risk medical devices and in vitro diagnostics."@en ;
                                        rdfs:label "EU High-Risk Medical Devices and IVD Ontology"@en ;
                                        owl:versionInfo "1.0" ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "OWL ontology for high-risk medical devices and in vitro diagnostics, including manufacturers, risks, incidents and field safety corrective actions."@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#argument1
<http://www.w3.org/2003/11/swrl#argument1> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#argument2
<http://www.w3.org/2003/11/swrl#argument2> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#body
<http://www.w3.org/2003/11/swrl#body> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#classPredicate
<http://www.w3.org/2003/11/swrl#classPredicate> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#head
<http://www.w3.org/2003/11/swrl#head> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#propertyPredicate
<http://www.w3.org/2003/11/swrl#propertyPredicate> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#varName
<http://www.w3.org/2003/11/swrl#varName> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.example.org/eu-meddevice#addressesIncident
:addressesIncident rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :FSCA ;
                   rdfs:range :Incident ;
                   rdfs:comment "Links an FSCA to the incident it addresses."@en ;
                   rdfs:label "addressesIncident"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Links an FSCA to the incident it addresses."@en .


###  http://www.example.org/eu-meddevice#affectsDevice
:affectsDevice rdf:type owl:ObjectProperty ;
               rdfs:domain :FSCA ;
               rdfs:range :Device ;
               rdfs:comment "Inferred property linking an FSCA to the device affected by the action."@en ;
               rdfs:label "affectsDevice"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Inferred property linking an FSCA to the device affected by the action."@en .


###  http://www.example.org/eu-meddevice#governedByFramework
:governedByFramework rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Device ;
                     rdfs:range :RegulatoryFramework ;
                     rdfs:comment "Links a device to the regulatory framework under which it is registered."@en ;
                     rdfs:label "governedByFramework"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Links a device to the regulatory framework under which it is registered."@en .


###  http://www.example.org/eu-meddevice#hasFSCAStatus
:hasFSCAStatus rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :FSCA ;
               rdfs:range :FSCAStatus ;
               rdfs:comment "Links an FSCA to its status."@en ;
               rdfs:label "hasFSCAStatus"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Links an FSCA to its status."@en .


###  http://www.example.org/eu-meddevice#hasManufacturer
:hasManufacturer rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Device ;
                 rdfs:range :Manufacturer ;
                 rdfs:comment "Links a device to its manufacturer."@en ;
                 rdfs:label "hasManufacturer"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Links a device to its manufacturer."@en .


###  http://www.example.org/eu-meddevice#hasPatientSex
:hasPatientSex rdf:type owl:ObjectProperty ;
               rdfs:domain :Incident ;
               rdfs:range :SexCategory ;
               rdfs:comment "Relates an incident to the patient sex category when available."@en ;
               rdfs:label "hasPatientSex"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates an incident to the patient sex category when available."@en .


###  http://www.example.org/eu-meddevice#hasProbability
:hasProbability rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Risk ;
                rdfs:range :ProbabilityLevel ;
                rdfs:comment "Links a risk to its probability level."@en ;
                rdfs:label "hasProbability"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Links a risk to its probability level."@en .


###  http://www.example.org/eu-meddevice#hasRelatedRisk
:hasRelatedRisk rdf:type owl:ObjectProperty ;
                rdfs:domain :Device ;
                rdfs:range :Risk ;
                rdfs:comment "Inferred property linking a device to a risk mentioned in an incident."@en ;
                rdfs:label "hasRelatedRisk"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Inferred property linking a device to a risk mentioned in an incident."@en .


###  http://www.example.org/eu-meddevice#hasRiskCategory
:hasRiskCategory rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Risk ;
                 rdfs:range :RiskCategory ;
                 rdfs:comment "Links a risk to its risk category."@en ;
                 rdfs:label "hasRiskCategory"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Links a risk to its risk category."@en .


###  http://www.example.org/eu-meddevice#hasRiskClass
:hasRiskClass rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Device ;
              rdfs:range :RiskClass ;
              rdfs:comment "Links a device to its risk class."@en ;
              rdfs:label "hasRiskClass"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Links a device to its risk class."@en .


###  http://www.example.org/eu-meddevice#hasSeverity
:hasSeverity rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Risk ;
             rdfs:range :SeverityLevel ;
             rdfs:comment "Links a risk to its severity level."@en ;
             rdfs:label "hasSeverity"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Links a risk to its severity level."@en .


###  http://www.example.org/eu-meddevice#involvesDevice
:involvesDevice rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Incident ;
                rdfs:range :Device ;
                rdfs:comment "Links an incident to the involved device."@en ;
                rdfs:label "involvesDevice"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Links an incident to the involved device."@en .


###  http://www.example.org/eu-meddevice#isAssociatedWithRisk
:isAssociatedWithRisk rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :Incident ;
                      rdfs:range :Risk ;
                      rdfs:comment "Links an incident to the related risk."@en ;
                      rdfs:label "isAssociatedWithRisk"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Links an incident to the related risk."@en .


###  http://www.example.org/eu-meddevice#isSubclassifiedUnder
:isSubclassifiedUnder rdf:type owl:ObjectProperty ,
                               owl:TransitiveProperty ;
                      rdfs:domain :MedicalCatalogueEntity ;
                      rdfs:range :MedicalCatalogueEntity ;
                      rdfs:comment "Transitive property reused from Exercise 1 to represent transitive classification links between classification resources."@en ;
                      rdfs:label "isSubclassifiedUnder"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Transitive property reused from Exercise 1 to represent transitive classification links between classification resources."@en .


###  http://www.example.org/eu-meddevice#locatedInCountry
:locatedInCountry rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Manufacturer ;
                  rdfs:range :Country ;
                  rdfs:comment "Links a manufacturer to its country."@en ;
                  rdfs:label "locatedInCountry"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Links a manufacturer to its country."@en .


###  http://www.example.org/eu-meddevice#reportedBy
:reportedBy rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Incident ;
            rdfs:range :ReportableEntity ;
            rdfs:comment "Links an incident to the reporting entity."@en ;
            rdfs:label "reportedBy"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Links an incident to the reporting entity."@en .


###  http://www.example.org/eu-meddevice#reportedInCountry
:reportedInCountry rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Incident ;
                   rdfs:range :Country ;
                   rdfs:comment "Links an incident to the country where it was reported."@en ;
                   rdfs:label "reportedInCountry"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Links an incident to the country where it was reported."@en .


###  http://www.example.org/eu-meddevice#supervisedBy
:supervisedBy rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Manufacturer ;
              rdfs:range :CompetentAuthority ;
              rdfs:comment "Links a manufacturer to its supervising competent authority."@en ;
              rdfs:label "supervisedBy"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Links a manufacturer to its supervising competent authority."@en .


#################################################################
#    Data properties
#################################################################

###  http://www.example.org/eu-meddevice#hasActionDate
:hasActionDate rdf:type owl:DatatypeProperty ;
               rdfs:domain :FSCA ;
               rdfs:range xsd:date ;
               rdfs:comment "Stores the action date."@en ;
               rdfs:label "hasActionDate"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Stores the action date."@en .


###  http://www.example.org/eu-meddevice#hasAuthorizationNumber
:hasAuthorizationNumber rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Manufacturer ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Stores the manufacturer authorisation number."@en ;
                        rdfs:label "hasAuthorizationNumber"@en ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Stores the manufacturer authorisation number."@en .


###  http://www.example.org/eu-meddevice#hasClosureDate
:hasClosureDate rdf:type owl:DatatypeProperty ;
                rdfs:domain :FSCA ;
                rdfs:range xsd:date ;
                rdfs:comment "Stores the closure date when available."@en ;
                rdfs:label "hasClosureDate"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Stores the closure date when available."@en .


###  http://www.example.org/eu-meddevice#hasContactEmail
:hasContactEmail rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Manufacturer ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Stores the regulatory contact email."@en ;
                 rdfs:label "hasContactEmail"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Stores the regulatory contact email."@en .


###  http://www.example.org/eu-meddevice#hasCorrectiveActionTaken
:hasCorrectiveActionTaken rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Incident ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Indicates whether a corrective action was taken."@en ;
                          rdfs:label "hasCorrectiveActionTaken"@en ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Indicates whether a corrective action was taken."@en .


###  http://www.example.org/eu-meddevice#hasCountriesAffected
:hasCountriesAffected rdf:type owl:DatatypeProperty ;
                      rdfs:domain :FSCA ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Stores the textual expression of affected countries."@en ;
                      rdfs:label "hasCountriesAffected"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Stores the textual expression of affected countries."@en .


###  http://www.example.org/eu-meddevice#hasDescription
:hasDescription rdf:type owl:DatatypeProperty ;
                rdfs:domain :MedicalCatalogueEntity ;
                rdfs:range xsd:string ;
                rdfs:comment "Stores a textual description."@en ;
                rdfs:label "hasDescription"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Stores a textual description."@en .


###  http://www.example.org/eu-meddevice#hasDetectionDate
:hasDetectionDate rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Incident ;
                  rdfs:range xsd:date ;
                  rdfs:comment "Stores the detection date."@en ;
                  rdfs:label "hasDetectionDate"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Stores the detection date."@en .


###  http://www.example.org/eu-meddevice#hasDeviceId
:hasDeviceId rdf:type owl:DatatypeProperty ;
             rdfs:domain :Device ;
             rdfs:range xsd:string ;
             rdfs:comment "Stores the device identifier."@en ;
             rdfs:label "hasDeviceId"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Stores the device identifier."@en .


###  http://www.example.org/eu-meddevice#hasDeviceName
:hasDeviceName rdf:type owl:DatatypeProperty ;
               rdfs:domain :Device ;
               rdfs:range xsd:string ;
               rdfs:comment "Stores the device commercial name."@en ;
               rdfs:label "hasDeviceName"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Stores the device commercial name."@en .


###  http://www.example.org/eu-meddevice#hasDevicesAffected
:hasDevicesAffected rdf:type owl:DatatypeProperty ;
                    rdfs:domain :FSCA ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Stores the number or textual expression of affected devices."@en ;
                    rdfs:label "hasDevicesAffected"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Stores the number or textual expression of affected devices."@en .


###  http://www.example.org/eu-meddevice#hasEUDAMEDSRN
:hasEUDAMEDSRN rdf:type owl:DatatypeProperty ;
               rdfs:domain :Manufacturer ;
               rdfs:range xsd:string ;
               rdfs:comment "Stores the EUDAMED SRN."@en ;
               rdfs:label "hasEUDAMEDSRN"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Stores the EUDAMED SRN."@en .


