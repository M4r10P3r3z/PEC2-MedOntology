:hasPatientAge rdf:type owl:DatatypeProperty ;
               rdfs:domain :Incident ;
               rdfs:range xsd:integer ;
               rdfs:comment "Stores the patient age when available."@en ;
               rdfs:label "hasPatientAge"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Stores the patient age when available."@en .


