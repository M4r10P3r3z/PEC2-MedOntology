:hasRiskName rdf:type owl:DatatypeProperty ;
             rdfs:domain :Risk ;
             rdfs:range xsd:string ;
             rdfs:comment "Stores the preferred risk name."@en ;
             rdfs:label "hasRiskName"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Stores the preferred risk name."@en .


###  http://www.example.org/eu-meddevice#hasScope
:hasScope rdf:type owl:DatatypeProperty ;
          rdfs:domain :FSCA ;
          rdfs:range xsd:string ;
          rdfs:comment "Stores the textual scope of the FSCA."@en ;
          rdfs:label "hasScope"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "Stores the textual scope of the FSCA."@en .


